* text=auto

*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.xml  text eol=lf

*.ffx  binary
*.png  binary
*.jpg  binary
*.zip  binary
*.zxp  binary

# Keep upstream source and generated prompt text byte-for-byte, including whitespace.
mcp/vendor/** whitespace=-blank-at-eol,-blank-at-eof
mcp/vendor/figwright/** text eol=lf
mcp/server.cjs whitespace=-blank-at-eol,-blank-at-eof
